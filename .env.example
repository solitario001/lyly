# ============================================
# Lyly Corpo — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:1234/v1

# Main conversation model
OLLAMA_MAIN_MODEL=meta-llama-3.1-8b-instruct-abliterated

# Lightweight pre-emotion analysis model
OLLAMA_PREEMOTION_MODEL=gemma-2-2b-it

# --- ChromaDB (Vector Memory) ---
CHROMA_DB_URL=http://localhost:8000

# Persistent database path (adjust to your system)
CHROMA_DB_PATH=./lyly-bot/db_final

# --- TTS (Text-to-Speech) ---
TTS_SERVER_URL=http://localhost:8005/generate

# --- Debug / Environment ---
NODE_ENV=development
